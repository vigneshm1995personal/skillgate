# Version control
.git/
.gitignore

# CI/CD
.github/
.gitlab-ci.yml
.circleci/

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo
*~

# Documentation (keep README.md + LICENSE for pip install .)
docs/
*.md
!README.md
!LICENSE
# Example packs must stay in the image (`COPY skills` + `skillgate example`).
!skills/
!skills/**

# Docker files (avoid recursive inclusion)
Dockerfile*
compose.yaml
docker-compose*.yml
docker-compose*.yaml
.dockerignore

# Environment and secrets
**/.npmrc
.env
.env.*
*.pem
*.key
db-creds.env
*.pypirc

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/
*.egg-info/
dist/
build/

# Test and coverage
coverage/
.coverage
htmlcov/
.pytest_cache/
.ruff_cache/
tests/

# OS files
.DS_Store
Thumbs.db
