# API keys — used for live `skillgate check` and Run live. Skip for the built-in checker.

# Cursor Agent CLI
# CURSOR_API_KEY=
# CURSOR_AGENT_BIN=agent

# Codex CLI (or OPENAI_API_KEY as fallback)
# CODEX_API_KEY=
# OPENAI_API_KEY=
# CODEX_BIN=codex
# CODEX_MODEL=
# CODEX_REASONING_EFFORT=medium

# OpenAI key also scores live checks (your key only). Unset or SKILLGATE_JUDGE=skip
# to keep the built-in checker.
# SKILLGATE_JUDGE=auto
# SKILLGATE_JUDGE_BACKEND=decisions
# SKILLGATE_JUDGE_MIN_CONFIDENCE=0.5
# SKILLGATE_JUDGE_WHY=1

# OpenAI-compatible HTTP (user-owned base; not required for demo)
# AI_GATEWAY_API_KEY=
# AI_GATEWAY_BASE_URL=https://api.openai.com/v1
# SKILLGATE_MODEL=openai/gpt-4o-mini

# Anthropic BYOLLM
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Sandbox
# SKILLGATE_SANDBOX=local
# SKILLGATE_DOCKER_IMAGE=skillgate-sandbox:v0
