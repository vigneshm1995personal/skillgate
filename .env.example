# Non-secret Skill Gate config. Keys do NOT go here.
# Set keys with `skillgate keys set` or Settings in `skillgate ui`.
# CI: SKILLGATE_OPENAI_API_KEY, or `skillgate check . --key-env OPENAI_API_KEY`.

# SKILLGATE_MODEL=openai/gpt-4o-mini
# SKILLGATE_HARNESS=auto
# SKILLGATE_SANDBOX=local
# SKILLGATE_DOCKER_IMAGE=skillgate-sandbox:v0
# SKILLGATE_JUDGE=auto
# SKILLGATE_JUDGE_BACKEND=decisions
# SKILLGATE_JUDGE_MIN_CONFIDENCE=0.5
# SKILLGATE_JUDGE_WHY=1

# CURSOR_AGENT_BIN=agent
# CODEX_BIN=codex
# CODEX_MODEL=
# CODEX_REASONING_EFFORT=medium
# ANTHROPIC_MODEL=claude-sonnet-4-20250514
# AI_GATEWAY_BASE_URL=https://ai-gateway.vercel.sh/v1
